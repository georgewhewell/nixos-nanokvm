result
result-*
.direnv

# Local access material. These are useful for standalone images, but
# downstream fleet configs should own real users and keys.
authorized_keys

# Legacy/local wpa_supplicant snippets. Credentials belong in the
# downstream fleet config or secrets system, not in this reusable repo.
wifi.conf

# Per-device snapshots taken before flashing (wifi PSK, tailscaled state,
# vendor /etc/kvm files). Always sensitive; never commit.
secrets/

# Host-side cached SSH host keys, generated/persisted by mkUsbBootRunner
# on first usb-boot and pushed to the device via the initrd debug shell
# so the SG2002 doesn't have to spend ~60 s wall-clock on sshd-keygen
# every boot. Per-developer, not committed.
.ssh_host_*_key
.ssh_host_*_key.pub

# Host runner status/log files from USB boot and kexec sessions.
.nanokvm-*.log
.nanokvm-*.pid

# Python helper byproducts.
__pycache__/
*.py[cod]

# Local terminal recordings and rendered boot GIFs.
media/captures/
