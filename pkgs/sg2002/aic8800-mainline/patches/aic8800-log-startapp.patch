Subject: [PATCH] aic8800: log START_APP fw_addr and boot_type around the
 cmd 1037 timeout so we can see which firmware blob was uploaded and at
 what address the chip is expected to start running.

--- a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
@@ -1716,10 +1716,14 @@ static int aicwifi_start_from_bootrom(struct aic_sdio_dev *sdiodev)
 	const u32 fw_addr = ((sdiodev->chipid == PRODUCT_ID_AIC8800D80X2) && (!testmode))?RAM_FMAC_FW_ADDR_D80X2:RAM_FMAC_FW_ADDR;
 	struct dbg_start_app_cfm start_app_cfm;
 
+	printk(KERN_INFO "aicbsp: 8801 start_app chipid=%d chip_rev=%d fw_addr=0x%08x boot_type=%d\n",
+		sdiodev->chipid, aicbsp_info.chip_rev, fw_addr, HOST_START_APP_AUTO);
+
 	/* fw start */
 	ret = rwnx_send_dbg_start_app_req(sdiodev, fw_addr, HOST_START_APP_AUTO, &start_app_cfm);
 	if (ret) {
+		printk(KERN_ERR "aicbsp: 8801 start_app FAILED ret=%d\n", ret);
 		return -1;
 	}
 	aicbsp_info.hwinfo_r = start_app_cfm.bootstatus & 0xFF;
 
