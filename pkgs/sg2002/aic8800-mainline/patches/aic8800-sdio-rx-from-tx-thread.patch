 {
 	int err = 0;
@@ -1997,6 +2031,9 @@
                 		break;
             		} else {
                 		aicwf_sdio_send(sdiodev->tx_priv, 0);
+				/* An aggregate just went out. */
+				if (atomic_read(&sdiodev->tx_priv->aggr_count) == 0)
+					aicwf_sdio_tx_service_rx(sdiodev);
             		}
         	}
 	}
@@ -2845,12 +2882,14 @@
 	spin_unlock_irqrestore(&rx_priv->rxqlock, flags);
 
 	atomic_inc(&rx_priv->rx_cnt);
+	aicwf_sdio_rx_enqueued++;
 }
 
 
