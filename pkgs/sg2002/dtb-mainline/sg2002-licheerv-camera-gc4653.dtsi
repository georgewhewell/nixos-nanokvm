/* LicheeRV-Nano GC4653 camera overlay (mainline).
 *
 * Board wiring recovered from the vendor tree (sipeed/LicheeRV-Nano-Build):
 *  - buildroot .../sensor_cfg.ini.beta: sensor on I2C bus 4 at 0x29,
 *    lane map clock=4 data=<3 2>, mclk id 1.
 *  - u-boot cvi_board_init.c (sg2002_licheervnano_sd): camera I2C is IIC4
 *    muxed onto the RTC-domain pins PWR_WAKEUP0 (reg 0x03001090, func 5 =
 *    IIC4_SCL) and PWR_BUTTON1 (0x03001098, func 5 = IIC4_SDA) — the vendor
 *    comments mislabel them "PWR_GPIO6/8", and CAM_MCLK1 out on the analog
 *    pad PAD_MIPIRX0N (0x0300118c, func 5). None of that survives into a
 *    mainline FIP, so pinctrl below redoes it.
 *  - sg2002_licheervnano_sd.dts: &mipi_rx snsr-reset = GPIOE1 active low.
 *
 * Fixed mode 2560x1440p30 SRGGB10 over two data lanes. Power-up is xvclk
 * (CAM_MCLK1, 24 MHz) + reset deassert, both owned by the gc4653 driver's
 * power-on path; the driver keeps the sensor clocked after probe so capture
 * can take ownership of stream on/off.
 */

#include <dt-bindings/clock/sophgo,cv1800.h>
#include <dt-bindings/gpio/gpio.h>

/*
 * The standalone DTB builder uses an unpatched Linux source tarball. Keep
 * these fallbacks until its cv18xx-reset.h contains the named CSI PHY IDs.
 */
#ifndef RST_CSI_PHY0
#define RST_CSI_PHY0 70
#endif
#ifndef RST_CSI_PHY0_APB
#define RST_CSI_PHY0_APB 71
#endif

&pinctrl {
	/* RTC-domain 1V8 pins; valid 1V8 drive strengths are
	 * 12800/25300/37400/49000 µA (sg2002_1v8_oc_map). */
	i2c4_cam_cfg: i2c4-cam-cfg {
		i2c4-cam-pins {
			pinmux = <PINMUX(PIN_PWR_WAKEUP0, 5)>, /* IIC4_SCL */
				 <PINMUX(PIN_PWR_BUTTON1, 5)>; /* IIC4_SDA */
			bias-pull-up;
			drive-strength-microamp = <12800>;
			power-source = <1800>;
		};
	};

	cam_mclk1_cfg: cam-mclk1-cfg {
		/* Analog MIPI pad: no bias/drive conf ops exist for it, but
		 * power-source is MANDATORY — cv1800_dt_node_to_map_post()
		 * rejects groups without it (map never registers, consumer
		 * probe then dies with -EINVAL in pinctrl_bind_pins). */
		cam-mclk1-pins {
			pinmux = <PINMUX(PIN_MIPIRX0N, 5)>; /* CAM_MCLK1 */
			power-source = <1800>;
		};
	};
};

/ {
	/* Deterministic DMA carveout for the capture/encode path: 5.5 MiB per
	 * 2560x1440 RAW12P frame; the driver's STREAMON-time scratch alloc
	 * plus a shallow buffer queue cannot rely on late-boot CMA on a
	 * 256 MiB board (observed -ENOMEM at STREAMON without this).
	 * dma_alloc_from_coherent() rounds each 5.5 MiB frame buffer to an
	 * order-11 (8 MiB) 8 MiB-aligned region, so budget 8 MiB per queued
	 * buffer plus the scratch. The 32 MiB pool covers Coda980's small 640x360
	 * arena plus a double-buffered CSI queue and scratch. The capture driver
	 * permits that explicit two-buffer queue; larger queues do not fit once
	 * Coda is active.
	 * Its base matches the NanoKVM-PCIe media-pool placement. */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		video_pool: video-pool@86800000 {
			compatible = "shared-dma-pool";
			no-map;
			reg = <0x86800000 0x2000000>;
		};
	};

	/* GPIOE sits in the RTC power domain and has no soft-reset line
	 * (RST_GPIO4 does not exist). Vendor DTS: PLIC source 70, which is
	 * SOC_PERIPHERAL_IRQ(54) after the 16 core-local IDs. */
	gpio4: gpio@5021000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x05021000 0x1000>;
		#address-cells = <1>;
		#size-cells = <0>;

		porte: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			reg = <0>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&plic>;
			interrupts = <SOC_PERIPHERAL_IRQ(54) IRQ_TYPE_LEVEL_HIGH>;
		};
	};

	ddr_top: syscon@800a000 {
		compatible = "sophgo,sg2002-ddr-top", "syscon";
		reg = <0x0800a000 0x1000>;
	};

	/* The generic SoC node is disabled, and the standalone DTB builder
	 * consumes an unpatched kernel source. Keep the complete enabled node
	 * here, sharing the deterministic media pool with CSI capture. */
	video-codec@b030000 {
		compatible = "sophgo,sg2002-coda980";
		reg = <0x0b030000 0x100>, <0x0b010000 0x10000>;
		reg-names = "vc-ctrl", "h264";
		interrupt-parent = <&plic>;
		interrupts = <SOC_PERIPHERAL_IRQ(5) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "h264";
		clocks = <&clk CLK_AXI_VIDEO_CODEC>,
			 <&clk CLK_CFG_REG_VC>,
			 <&clk CLK_VC_SRC0>,
			 <&clk CLK_H264C>,
			 <&clk CLK_APB_H264C>;
		clock-names = "axi-video-codec", "cfg-reg-vc", "vc-src0",
			      "h264c", "apb-h264c";
		resets = <&rst RST_H264C>;
		firmware-name = "sophgo/sg2002/coda980.bin";
		memory-region = <&video_pool>;
		status = "okay";
	};

	/* ISP NV21 -> VPSS -> NV12 encoder surfaces. VPSS imports the capture
	 * and encoder DMA-BUFs; a private reserved-memory attachment would
	 * prevent those imports. Keep the fabric clocks for its whole session.
	 */
	vpss: vpss@a080000 {
		compatible = "sophgo,sg2002-vpss";
		reg = <0x0a080000 0x10000>;
		interrupt-parent = <&plic>;
		interrupts = <SOC_PERIPHERAL_IRQ(9) IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk CLK_SRC_VIP_SYS_0>,
			 <&clk CLK_SRC_VIP_SYS_1>,
			 <&clk CLK_SRC_VIP_SYS_2>,
			 <&clk CLK_IMG_V_VIP>,
			 <&clk CLK_SC_TOP_VIP>,
			 <&clk CLK_SC_V1_VIP>,
			 <&clk CLK_AXI_VIP>,
			 <&clk CLK_CFG_REG_VIP>;
		clock-names = "sys0", "sys1", "sys2", "img_v", "sc_top", "sc_v1",
			      "axi", "cfg_reg";
		status = "okay";
	};

	/* CSI MAC0 -> CSIBDG0 -> DMA6 capture, as on the NanoKVM-PCIe
	 * carrier, but fed by the GC4653 instead of the LT6911 HDMI bridge. */
	csi_capture: video-capture@a0c2000 {
		compatible = "sophgo,sg2002-csi-capture";
		reg = <0x0a0c2000 0x2000>,
		      <0x0a0d0000 0x1000>,
		      <0x0a000000 0x80000>,
		      <0x0a0c8000 0x2000>;
		reg-names = "csi-mac0", "csi-wrap", "vi", "vip-sys";
		interrupt-parent = <&plic>;
		/* Vendor DTS numbers these PLIC sources directly as VI=24 and
		 * CSI0=26.  Mainline's SOC_PERIPHERAL_IRQ() accounts for the 16
		 * core-local interrupt IDs, so its peripheral indices are 8/10. */
		interrupts = <SOC_PERIPHERAL_IRQ(8) IRQ_TYPE_LEVEL_HIGH>,
			     <SOC_PERIPHERAL_IRQ(10) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "vi", "csi";
		clocks = <&clk CLK_SRC_VIP_SYS_0>,
			 <&clk CLK_SRC_VIP_SYS_1>,
			 <&clk CLK_SRC_VIP_SYS_2>,
			 <&clk CLK_SRC_VIP_SYS_3>,
			 <&clk CLK_AXI_VIP>,
			 <&clk CLK_CFG_REG_VIP>,
			 <&clk CLK_VIP_IP0>,
			 <&clk CLK_VIP_IP1>,
			 <&clk CLK_VIP_IP2>,
			 <&clk CLK_VIP_IP3>,
			 <&clk CLK_CSI_BE_VIP>,
			 <&clk CLK_RAW_VIP>,
			 <&clk CLK_ISP_TOP_VIP>,
			 <&clk CLK_CSI_MAC0_VIP>,
			 <&clk CLK_CSI0_RX_VIP>;
		clock-names = "vip-sys0", "vip-sys1", "vip-sys2", "vip-sys3",
			      "axi", "cfg-reg", "vip-ip0", "vip-ip1", "vip-ip2",
			      "vip-ip3", "csi-be", "raw", "isp-top",
			      "csi-mac0", "csi0-rx";
		resets = <&rst RST_CSI_PHY0>, <&rst RST_CSI_PHY0_APB>;
		reset-names = "csi-phy", "csi-phy-apb";
		sophgo,ddr-top = <&ddr_top>;
		memory-region = <&video_pool>;
		status = "okay";

		port {
			sg2002_csi_in: endpoint {
				remote-endpoint = <&gc4653_out>;
				bus-type = <4>; /* CSI-2 D-PHY */
				/* Factory sensor_cfg.ini.beta lane map. */
				clock-lanes = <4>;
				data-lanes = <3 2>;
			};
		};
	};
};

&i2c4 {
	pinctrl-0 = <&i2c4_cam_cfg>;
	pinctrl-names = "default";
	status = "okay";

	gc4653: camera-sensor@29 {
		compatible = "galaxycore,gc4653";
		reg = <0x29>;
		pinctrl-0 = <&cam_mclk1_cfg>;
		pinctrl-names = "default";
		clocks = <&clk CLK_CAM1>;
		clock-names = "xvclk";
		/* Keep the sensor's clock assignment on its consumer: the shared
		 * CPUFreq overlay assigns MPLL on the clock-controller node. */
		assigned-clocks = <&clk CLK_CAM1>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&porte 1 GPIO_ACTIVE_LOW>;

		port {
			gc4653_out: endpoint {
				remote-endpoint = <&sg2002_csi_in>;
				bus-type = <4>; /* CSI-2 D-PHY */
				clock-lanes = <4>;
				data-lanes = <3 2>;
			};
		};
	};
};
