-  }
-
-  if (heap_id > MAX_HEAP_COUNT) {
-    TPU_LOG_WARNING("no carveout heap found\n");
-    return BM_ERR_FAILURE;
-  }
-
-  dev->ion_heap_id = heap_id;
-  return BM_SUCCESS;
-}
