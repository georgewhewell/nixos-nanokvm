+++ b/src/soc/common/sg2002_backend.cpp
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: MIT
+// SG2002 mainline backend: owned DMA allocations, explicit CPU copies and
+// synchronous job completion. No ION, physical mmap or cache-maintenance ABI.
+#include "cvi_device_mem.h"
+extern "C" {
+#include <sg2002-tpu-runtime.h>
+}
+#include <climits>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <vector>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+namespace {
+struct Buffer {
+  int fd;
+  sg2002_tpu_buffer dma;
+  uint8_t *cpu;
+};
+std::mutex buffers_lock;
+std::map<int, Buffer> buffers;
+unsigned next_buffer = 1;
+
+bmerr_t transfer(bmdev_t dev, int id, uint64_t address, size_t size, bool to_device) {
+  std::lock_guard<std::mutex> guard(buffers_lock);
+  auto it = buffers.find(id);
+  if (it == buffers.end() || it->second.fd != dev->dev_fd)
+    return BM_ERR_FAILURE;
+  Buffer &b = it->second;
+  if (address < b.dma.dma_address || address - b.dma.dma_address > b.dma.size)
+    return BM_ERR_FAILURE;
+  uint32_t offset = address - b.dma.dma_address;
+  if (size > b.dma.size - offset)
+    return BM_ERR_FAILURE;
+  int ret = to_device ? sg2002_tpu_write(b.fd, &b.dma, offset, b.cpu + offset, size) :
+                        sg2002_tpu_read(b.fd, &b.dma, offset, b.cpu + offset, size);
+  return ret ? BM_ERR_FAILURE : BM_SUCCESS;
+}
+
+// Resolve the model's eight array bases into TDMA global addresses. The kernel
+// accepts buffer handles as bases; model bases may point inside an allocation.
+bool relocate_tdma(uint32_t *words, const uint64_t base[8]) {
+  unsigned direction = (words[0] >> 6) & 3;
+  if (direction == 0 || direction == 2) {
+    unsigned index = (words[3] >> 16) & 7;
+    uint64_t address = words[12] | (uint64_t(words[13] >> 24) << 32);
+    if (base[index] > UINT32_MAX || address > UINT32_MAX - base[index])
+      return false;
+    address += base[index];
+    words[12] = address;
+    words[13] &= 0x00ffffff;
+    words[3] &= ~(7u << 16);
+  }
+  if (direction == 1 || direction == 2) {
+    unsigned index = (words[3] >> 20) & 7;
+    uint64_t address = words[11] | (uint64_t((words[13] >> 16) & 255) << 32);
+    if (base[index] > UINT32_MAX || address > UINT32_MAX - base[index])
+      return false;
+    address += base[index];
+    words[11] = address;
+    words[13] &= 0xff00ffff;
+    words[3] &= ~(7u << 20);
+  }
+  return true;
+}
+} // namespace
+
+bmerr_t CviDeviceMem::mem_alloc(bmdev_t dev, size_t size, uint64_t *paddr,
+                               uint8_t **vaddr, int *id) {
+  if (!size || size > UINT32_MAX)
+    return BM_ERR_FAILURE;
+  std::lock_guard<std::mutex> guard(buffers_lock);
+  if (next_buffer > INT_MAX)
+    return BM_ERR_FAILURE;
+  Buffer b = {dev->dev_fd, {}, nullptr};
+  if (sg2002_tpu_alloc(b.fd, size, &b.dma))
+    return BM_ERR_FAILURE;
+  void *memory = nullptr;
+  if (posix_memalign(&memory, 4096, b.dma.size)) {
+    sg2002_tpu_free(b.fd, &b.dma);
+    return BM_ERR_FAILURE;
+  }
+  b.cpu = static_cast<uint8_t *>(memory);
+  memset(b.cpu, 0, b.dma.size);
+  *id = next_buffer++;
+  *paddr = b.dma.dma_address;
+  *vaddr = b.cpu;
+  buffers.emplace(*id, b);
+  return BM_SUCCESS;
+}
+
+void CviDeviceMem::close_buffers(bmdev_t dev) {
+  std::lock_guard<std::mutex> guard(buffers_lock);
+  for (auto it = buffers.begin(); it != buffers.end();) {
+    if (it->second.fd == dev->dev_fd) {
+      free(it->second.cpu);
+      it = buffers.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  // Closing the file releases its kernel allocations after any active job.
+  close(dev->dev_fd);
+}
+
+bmerr_t CviDeviceMem::mem_free(uint8_t *vaddr, size_t, int id) {
+  std::lock_guard<std::mutex> guard(buffers_lock);
+  auto it = buffers.find(id);
+  if (it == buffers.end() || it->second.cpu != vaddr)
+    return BM_ERR_FAILURE;
+  int ret = sg2002_tpu_free(it->second.fd, &it->second.dma);
+  free(it->second.cpu);
+  buffers.erase(it);
+  return ret ? BM_ERR_FAILURE : BM_SUCCESS;
+}
+
+bmerr_t CviDeviceMem::mem_flush_ext(bmdev_t dev, int id, uint64_t address, size_t size) {
+  return transfer(dev, id, address, size, true);
+}
+bmerr_t CviDeviceMem::mem_invld_ext(bmdev_t dev, int id, uint64_t address, size_t size) {
+  return transfer(dev, id, address, size, false);
+}
+bmerr_t CviDeviceMem::mem_flush_fd(bmdev_t dev, int id) {
+  uint64_t address;
+  uint32_t size;
+  {
+    std::lock_guard<std::mutex> guard(buffers_lock);
+    auto it = buffers.find(id);
+    if (it == buffers.end()) return BM_ERR_FAILURE;
+    address = it->second.dma.dma_address;
+    size = it->second.dma.size;
+  }
+  return transfer(dev, id, address, size, true);
+}
+bmerr_t CviDeviceMem::mem_invld_fd(bmdev_t dev, int id) {
+  uint64_t address;
+  uint32_t size;
+  {
+    std::lock_guard<std::mutex> guard(buffers_lock);
+    auto it = buffers.find(id);
+    if (it == buffers.end()) return BM_ERR_FAILURE;
+    address = it->second.dma.dma_address;
+    size = it->second.dma.size;
+  }
+  return transfer(dev, id, address, size, false);
+}
+
+bmerr_t CviDeviceMem::submit_dmabuf(bmdev_t dev, int id, uint32_t) {
+  std::lock_guard<std::mutex> guard(buffers_lock);
+  auto it = buffers.find(id);
+  if (it == buffers.end() || it->second.fd != dev->dev_fd)
+    return BM_ERR_FAILURE;
+  Buffer &b = it->second;
+  if (b.dma.size < sizeof(dma_hdr_t))
+    return BM_ERR_FAILURE;
+  const dma_hdr_t *header = reinterpret_cast<const dma_hdr_t *>(b.cpu);
+  if (header->dmabuf_magic_m != 0xb5b5 ||
+      header->dmabuf_size > b.dma.size ||
+      !header->cpu_desc_count || header->cpu_desc_count > SG2002_TPU_MAX_BATCH ||
+      header->cpu_desc_count > (b.dma.size - sizeof(*header)) / sizeof(cvi_cpu_desc_t) ||
+      header->pmubuf_size)
+    return BM_ERR_FAILURE;
+  uint64_t bases[8];
+  const uint32_t *parts = &header->arraybase_0_L;
+  for (unsigned i = 0; i < 8; i++)
+    bases[i] = parts[2 * i] | (uint64_t(parts[2 * i + 1]) << 32);
+  const auto *segments = reinterpret_cast<const cvi_cpu_desc_t *>(b.cpu + sizeof(*header));
+  std::vector<sg2002_tpu_submit> jobs;
+  std::vector<std::vector<uint32_t>> descriptors(header->cpu_desc_count);
+  for (unsigned segment = 0; segment < header->cpu_desc_count; segment++) {
+    const auto &d = segments[segment];
+    if (d.op_type != 2) { // CPU_OP_SYNC; CPU opcodes are not silently skipped.
+      fprintf(stderr, "Unsupported TPU CPU descriptor opcode %u\n", d.op_type);
+      return BM_ERR_FAILURE;
+    }
+    uint32_t tiu_count = d.num_tiu & 0xffff, tdma_count = d.num_tdma & 0xffff;
+    uint64_t tiu_address = uint64_t(d.offset_tiu) << 8;
+    uint64_t tdma_address = uint64_t(d.offset_tdma) << 6;
+    size_t tiu_bytes = size_t(tiu_count) * 112, tdma_bytes = size_t(tdma_count) * 64;
+    auto in_range = [&b](uint64_t address, size_t bytes) {
+      return address >= b.dma.dma_address && address - b.dma.dma_address <= b.dma.size &&
+             bytes <= b.dma.size - (address - b.dma.dma_address);
+    };
+    if ((tiu_count && !in_range(tiu_address, tiu_bytes)) ||
+        (tdma_count && !in_range(tdma_address, tdma_bytes)))
+      return BM_ERR_FAILURE;
+    if (!tiu_count && !tdma_count)
+      continue;
+    auto &tdma = descriptors[segment];
+    tdma.resize(tdma_count * 16);
+    if (tdma_count)
+      memcpy(tdma.data(), b.cpu + (tdma_address - b.dma.dma_address), tdma_bytes);
+    for (unsigned i = 0; i < tdma_count; i++)
+      if (!relocate_tdma(&tdma[i * 16], bases))
+        return BM_ERR_FAILURE;
+    sg2002_tpu_submit job = {};
+    job.tiu = tiu_count ? reinterpret_cast<uintptr_t>(b.cpu + (tiu_address - b.dma.dma_address)) : 0;
+    job.tdma = reinterpret_cast<uintptr_t>(tdma.data());
+    job.tiu_count = tiu_count;
+    job.tdma_count = tdma_count;
+    jobs.push_back(job);
+  }
+  if (jobs.empty())
+    return BM_ERR_FAILURE;
+  sg2002_tpu_batch batch = {};
+  batch.jobs = reinterpret_cast<uintptr_t>(jobs.data());
+  batch.count = jobs.size();
+  if (ioctl(dev->dev_fd, SG2002_TPU_BATCH, &batch)) {
+    perror("SG2002 TPU model submission");
+    return BM_ERR_FAILURE;
+  }
+  return BM_SUCCESS;
+}
+
+// Submission completes synchronously; failures are returned by submit_dmabuf.
+bmerr_t CviDeviceMem::wait_dmabuf(bmdev_t, uint32_t) { return BM_SUCCESS; }
+bmerr_t CviDeviceMem::reopen_dev(bmdev_t, int) { return BM_ERR_FAILURE; }
