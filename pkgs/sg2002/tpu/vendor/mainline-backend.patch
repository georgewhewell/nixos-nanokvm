-  int ret;
-
-  memset(&query, 0, sizeof(query));
-  query.cnt = MAX_HEAP_COUNT;
-  query.heaps = (unsigned long int)&heap_data[0];
-  ret = ioctl(dev->ion_fd, ION_IOC_HEAP_QUERY, &query);
-  if (ret != 0) {
-    TPU_LOG_WARNING("io query heap failed, ret=%x\n", ret);
