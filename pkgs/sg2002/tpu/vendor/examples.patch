diff --git a/samples/sg2002_forward.h b/samples/sg2002_forward.h
new file mode 100644
index 0000000..c500d9f
--- /dev/null
+++ b/samples/sg2002_forward.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+// Measure synchronous hardware inference and check repeat determinism.
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <vector>
+#include <cviruntime.h>
+
+static double elapsed(const timespec &a, const timespec &b) {
+  return (b.tv_sec - a.tv_sec) * 1000.0 + (b.tv_nsec - a.tv_nsec) / 1000000.0;
+}
+
+static bool sg2002_forward(CVI_MODEL_HANDLE model, CVI_TENSOR *inputs, int input_num,
+                          CVI_TENSOR *outputs, int output_num, const char *repeat_arg) {
+  char *end = nullptr;
+  unsigned long repeats = repeat_arg ? strtoul(repeat_arg, &end, 10) : 1;
+  if (!repeats || repeats > 10000 || (end && *end)) {
+    fprintf(stderr, "repeats must be 1..10000\n");
+    return false;
+  }
+  std::vector<std::vector<unsigned char>> reference(output_num);
+  double wall = 0, cpu = 0;
+  for (unsigned long i = 0; i < repeats; i++) {
+    timespec a, b, ca, cb;
+    clock_gettime(CLOCK_MONOTONIC, &a);
+    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &ca);
+    int ret = CVI_NN_Forward(model, inputs, input_num, outputs, output_num);
+    clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &cb);
+    clock_gettime(CLOCK_MONOTONIC, &b);
+    if (ret != CVI_RC_SUCCESS) {
+      fprintf(stderr, "CVI_NN_Forward failed: %d\n", ret);
+      return false;
+    }
+    wall += elapsed(a, b);
+    cpu += elapsed(ca, cb);
+    for (int t = 0; t < output_num; t++) {
+      auto ptr = static_cast<unsigned char *>(CVI_NN_TensorPtr(&outputs[t]));
+      size_t bytes = outputs[t].mem_size;
+      if (!i) reference[t].assign(ptr, ptr + bytes);
+      else if (memcmp(ptr, reference[t].data(), bytes)) {
+        fprintf(stderr, "Output %d changed on repeat %lu\n", t, i);
+        return false;
+      }
+    }
+  }
+  printf("TPU inference: %lu repeats, %.3f ms wall, %.3f ms process CPU per inference\n",
+         repeats, wall / repeats, cpu / repeats);
+  return true;
+}
