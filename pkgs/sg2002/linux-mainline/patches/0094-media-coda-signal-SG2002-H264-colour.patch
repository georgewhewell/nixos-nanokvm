From: George Whewell <georgerw@gmail.com>
Subject: [PATCH] media: coda: signal negotiated colour in SG2002 H.264

Coda980 emits no VUI, so players assume limited-range video even when
camera frames are full-range sRGB. Use the existing SPS crop fixup to
also emit video signal information from the negotiated V4L2 format.
Apply the extra header rewrite only to the SG2002 firmware ABI.

---
diff --git a/drivers/media/platform/chips-media/coda/coda-bit.c b/drivers/media/platform/chips-media/coda/coda-bit.c
index 5ae013a..6e7fe77 100644
--- a/drivers/media/platform/chips-media/coda/coda-bit.c
+++ b/drivers/media/platform/chips-media/coda/coda-bit.c
@@ -1510,9 +1510,10 @@ static int coda_start_encoding(struct coda_ctx *ctx)
 		 * fix up the SPS RBSP (Sequence Parameter Set Raw Byte
 		 * Sequence Payload) ourselves.
 		 */
-		if (ctx->dev->devtype->product != CODA_960 &&
-		    ((q_data_src->rect.width % 16) ||
-		     (q_data_src->rect.height % 16))) {
+		if (ctx->dev->devtype->firmware_product == 0x9800 ||
+		    (ctx->dev->devtype->product != CODA_960 &&
+		     ((q_data_src->rect.width % 16) ||
+		      (q_data_src->rect.height % 16)))) {
 			ret = coda_h264_sps_fixup(ctx, q_data_src->rect.width,
 						  q_data_src->rect.height,
 						  &ctx->vpu_header[0][0],
diff --git a/drivers/media/platform/chips-media/coda/coda-h264.c b/drivers/media/platform/chips-media/coda/coda-h264.c
index 8bd0aa8..63ce53b 100644
--- a/drivers/media/platform/chips-media/coda/coda-h264.c
+++ b/drivers/media/platform/chips-media/coda/coda-h264.c
@@ -235,6 +235,63 @@ static int rbsp_read_sev(struct rbsp *rbsp, int *val)
 	return 0;
 }
 
+/* H.264 Annex E / V4L2 colourimetry. Coda980 emits no VUI; preserve the
+ * negotiated signal range and transfer rather than making players guess.
+ */
+static int coda_h264_write_colour(struct coda_ctx *ctx, struct rbsp *sps)
+{
+	u32 enc = ctx->ycbcr_enc, xfer = ctx->xfer_func, range = ctx->quantization;
+	u32 primaries = 2, transfer = 2, matrix = 2;
+	int ret;
+
+	if (enc == V4L2_YCBCR_ENC_DEFAULT)
+		enc = V4L2_MAP_YCBCR_ENC_DEFAULT(ctx->colorspace);
+	if (xfer == V4L2_XFER_FUNC_DEFAULT)
+		xfer = V4L2_MAP_XFER_FUNC_DEFAULT(ctx->colorspace);
+	if (range == V4L2_QUANTIZATION_DEFAULT)
+		range = V4L2_MAP_QUANTIZATION_DEFAULT(false, ctx->colorspace, enc);
+	if (ctx->colorspace == V4L2_COLORSPACE_SRGB ||
+	    ctx->colorspace == V4L2_COLORSPACE_REC709)
+		primaries = 1;
+	else if (ctx->colorspace == V4L2_COLORSPACE_SMPTE170M)
+		primaries = 6;
+	if (xfer == V4L2_XFER_FUNC_SRGB)
+		transfer = 13;
+	else if (xfer == V4L2_XFER_FUNC_709)
+		transfer = 1;
+	else if (xfer == V4L2_XFER_FUNC_NONE)
+		transfer = 8;
+	if (enc == V4L2_YCBCR_ENC_601)
+		matrix = 6;
+	else if (enc == V4L2_YCBCR_ENC_709)
+		matrix = 1;
+
+	/* aspect_ratio_info/overscan absent, video_signal_type present. */
+	ret = rbsp_write_bits(sps, 3, 1);
+	if (ret)
+		return ret;
+	ret = rbsp_write_bits(sps, 3, 5); /* unspecified video_format */
+	if (ret)
+		return ret;
+	ret = rbsp_write_bit(sps, range == V4L2_QUANTIZATION_FULL_RANGE);
+	if (ret)
+		return ret;
+	ret = rbsp_write_bit(sps, 1); /* colour_description_present */
+	if (ret)
+		return ret;
+	ret = rbsp_write_bits(sps, 8, primaries);
+	if (ret)
+		return ret;
+	ret = rbsp_write_bits(sps, 8, transfer);
+	if (ret)
+		return ret;
+	ret = rbsp_write_bits(sps, 8, matrix);
+	if (ret)
+		return ret;
+	/* No chroma location, timing, HRD, pic_struct or bitstream restriction. */
+	return rbsp_write_bits(sps, 6, 0);
+}
+
 /**
  * coda_h264_sps_fixup - fixes frame cropping values in h.264 SPS
  * @ctx: encoder context
@@ -416,13 +473,23 @@ int coda_h264_sps_fixup(struct coda_ctx *ctx, int width, int height, char *buf,
 	ret = rbsp_write_uev(&sps, crop_bottom);
 	if (ret)
 		return ret;
-	ret = rbsp_write_bit(&sps, 0); /* vui_parameters_present_flag */
+	ret = rbsp_write_bit(&sps, ctx->dev->devtype->firmware_product == 0x9800);
 	if (ret)
 		return ret;
+	if (ctx->dev->devtype->firmware_product == 0x9800) {
+		ret = coda_h264_write_colour(ctx, &sps);
+		if (ret)
+			return ret;
+	}
 	ret = rbsp_write_bit(&sps, 1);
 	if (ret)
 		return ret;
 
+	while (sps.pos % 8) {
+		ret = rbsp_write_bit(&sps, 0);
+		if (ret)
+			return ret;
+	}
 	*size = 5 + DIV_ROUND_UP(sps.pos, 8);
 
 	return 0;
