+static int sh1107fb_write_cmd(struct i2c_client *client, u8 cmd)
+{
+	struct ssd1307fb_array *array;
+	int ret;
+
+	array = ssd1307fb_alloc_array(1, SH1107FB_COMMAND);
+	if (!array)
+		return -ENOMEM;
+
+	array->data[0] = cmd;
+
+	ret = ssd1307fb_write_array(client, array, 1);
+	kfree(array);
+
+	return ret;
+}
+
+static int sh1107fb_set_page_address(struct ssd1307fb_par *par, u8 page,
+				     u8 col)
+{
+	int ret;
+
+	ret = sh1107fb_write_cmd(par->client,
+				 SSD1307FB_START_PAGE_ADDRESS | page);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, 0x10 | ((col >> 4) & 0x0f));
+	if (ret < 0)
+		return ret;
+
+	return sh1107fb_write_cmd(par->client, col & 0x0f);
+}
+
+static int sh1107fb_update_rect(struct ssd1307fb_par *par, unsigned int x,
+				unsigned int y, unsigned int width,
+				unsigned int height)
+{
+	struct ssd1307fb_array *array;
+	u8 *vmem = par->info->screen_buffer;
+	unsigned int line_length = par->info->fix.line_length;
+	unsigned int pages = DIV_ROUND_UP(y % 8 + height, 8);
+	int ret = 0;
+	int i, j, k;
+	unsigned int chunk_x, chunk_width;
+
+	array = ssd1307fb_alloc_array(min_t(unsigned int, width,
+					    SH1107FB_MAX_DATA_CHUNK),
+				      SSD1307FB_DATA);
+	if (!array)
+		return -ENOMEM;
+
+	for (i = y / 8; i < y / 8 + pages; i++) {
+		int m = 8;
+		u32 array_idx = 0;
+
+		if (8 * (i + 1) > par->height)
+			m = par->height % 8;
+
+		for (chunk_x = x; chunk_x < x + width;
+		     chunk_x += chunk_width) {
+			chunk_width = min_t(unsigned int, SH1107FB_MAX_DATA_CHUNK,
+					    x + width - chunk_x);
+			array_idx = 0;
+
+			ret = sh1107fb_set_page_address(par, par->page_offset + i,
+							par->col_offset + chunk_x);
+			if (ret < 0)
+				goto out_free;
+
+			for (j = chunk_x; j < chunk_x + chunk_width; j++) {
+				u8 data = 0;
+
+				for (k = 0; k < m; k++) {
+					u8 byte = vmem[(8 * i + k) *
+						       line_length + j / 8];
+					u8 bit = (byte >> (j % 8)) & 1;
+
+					data |= bit << k;
+				}
+				array->data[array_idx++] = data;
+			}
+
+			ret = ssd1307fb_write_array(par->client, array,
+						    chunk_width);
+			if (ret < 0)
+				goto out_free;
+		}
+	}
+
+out_free:
+	kfree(array);
+	return ret;
+}
