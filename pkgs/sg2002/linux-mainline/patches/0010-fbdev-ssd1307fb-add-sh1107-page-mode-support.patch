+static int sh1107fb_init(struct ssd1307fb_par *par)
+{
+	u32 precharge, dclk, com_invdir;
+	u8 seg_remap, dcdc;
+	int ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_DISPLAY_OFF);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_SET_CLOCK_FREQ);
+	if (ret < 0)
+		return ret;
+
+	dclk = ((par->dclk_div - 1) & 0xf) | (par->dclk_frq & 0xf) << 4;
+	ret = sh1107fb_write_cmd(par->client, dclk);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_SET_ADDRESS_MODE);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_CONTRAST);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, par->contrast);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SH1107FB_DCDC);
+	if (ret < 0)
+		return ret;
+
+	dcdc = par->device_info->sh1107_dcdc ?: 0x8b;
+	ret = sh1107fb_write_cmd(par->client, dcdc);
+	if (ret < 0)
+		return ret;
+
+	seg_remap = par->seg_remap ? SSD1307FB_SEG_REMAP_ON : 0xa0;
+	ret = sh1107fb_write_cmd(par->client, seg_remap);
+	if (ret < 0)
+		return ret;
+
+	com_invdir = 0xc0 | par->com_invdir << 3;
+	ret = sh1107fb_write_cmd(par->client, com_invdir);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SH1107FB_DISPLAY_START_LINE);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_SET_DISPLAY_OFFSET);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, par->com_offset);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_SET_PRECHARGE_PERIOD);
+	if (ret < 0)
+		return ret;
+
+	precharge = (par->prechargep1 & 0xf) | (par->prechargep2 & 0xf) << 4;
+	ret = sh1107fb_write_cmd(par->client, precharge);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_SET_VCOMH);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, par->vcomh);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, SSD1307FB_SET_MULTIPLEX_RATIO);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, par->height - 1);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, 0xa4);
+	if (ret < 0)
+		return ret;
+
+	ret = sh1107fb_write_cmd(par->client, 0xa6);
+	if (ret < 0)
+		return ret;
+
+	msleep(100);
+
+	ret = ssd1307fb_update_display(par);
+	if (ret < 0)
+		return ret;
+
+	return sh1107fb_write_cmd(par->client, SSD1307FB_DISPLAY_ON);
+}
