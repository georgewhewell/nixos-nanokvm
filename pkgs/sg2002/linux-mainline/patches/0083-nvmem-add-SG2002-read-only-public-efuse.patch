From: George Whewell <georgerw@gmail.com>
Subject: [PATCH] nvmem: add read-only SG2002 public eFuse shadow access

Expose only the documented user words and device ID through NVMEM.
Preserve the physical shadow offsets, mask all other fields with NVMEM
keepouts, and enable both eFuse clocks around reads. No controller write
or fuse programming operation is provided.

The public offsets and clocked shadow-read sequence follow Sophgo's
cv181x_efuse.c and U-Boot cmd/efuse.c in duo-buildroot-sdk-v2 commit
6f8962c394dd0a05729abb089f0feb7d5cc4aa5e. The device ID is not assumed to
be a unique serial number or MAC address.

Signed-off-by: George Whewell <georgerw@gmail.com>
---
diff --git a/Documentation/devicetree/bindings/nvmem/sophgo,sg2002-efuse.yaml b/Documentation/devicetree/bindings/nvmem/sophgo,sg2002-efuse.yaml
new file mode 100644
index 0000000..6f79681
--- /dev/null
+++ b/Documentation/devicetree/bindings/nvmem/sophgo,sg2002-efuse.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/nvmem/sophgo,sg2002-efuse.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sophgo SG2002 eFuse
+
+maintainers:
+  - George Whewell <georgerw@gmail.com>
+
+description: |
+  The controller provides a 256-byte logical shadow aperture at offset 0x100.
+  The ten public user words occupy offsets 0x40, 0x48, ..., 0x88 within that
+  aperture. The eight-byte device ID starts at shadow offset 0x8c. These
+  offsets are relative to the shadow aperture, not to the controller base.
+  The device ID is not specified to be a unique serial number.
+
+allOf:
+  - $ref: nvmem.yaml#
+
+properties:
+  compatible:
+    const: sophgo,sg2002-efuse
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: efuse
+      - const: apb
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sophgo,cv1800.h>
+
+    efuse@3050000 {
+        compatible = "sophgo,sg2002-efuse";
+        reg = <0x03050000 0x1000>;
+        clocks = <&clk CLK_EFUSE>, <&clk CLK_APB_EFUSE>;
+        clock-names = "efuse", "apb";
+    };
diff --git a/arch/riscv/boot/dts/sophgo/sg2002.dtsi b/arch/riscv/boot/dts/sophgo/sg2002.dtsi
index 98001cc..cc78d29 100644
--- a/arch/riscv/boot/dts/sophgo/sg2002.dtsi
+++ b/arch/riscv/boot/dts/sophgo/sg2002.dtsi
@@ -30,6 +30,13 @@ pinctrl: pinctrl@3001000 {
 			reg-names = "sys", "rtc";
 		};
 
+		efuse: efuse@3050000 {
+			compatible = "sophgo,sg2002-efuse";
+			reg = <0x03050000 0x1000>;
+			clocks = <&clk CLK_EFUSE>, <&clk CLK_APB_EFUSE>;
+			clock-names = "efuse", "apb";
+		};
+
 		clk: clock-controller@3002000 {
 			compatible = "sophgo,sg2002-clk", "sophgo,sg2000-clk";
 			reg = <0x03002000 0x1000>;
diff --git a/drivers/nvmem/Kconfig b/drivers/nvmem/Kconfig
index 74ddbd0..788d528 100644
--- a/drivers/nvmem/Kconfig
+++ b/drivers/nvmem/Kconfig
@@ -404,6 +404,15 @@ config NVMEM_STM32_ROMEM
 	  This driver can also be built as a module. If so, the module
 	  will be called nvmem-stm32-romem.
 
+config NVMEM_SG2002_EFUSE
+	tristate "Sophgo SG2002 public eFuse shadow support"
+	depends on ARCH_SOPHGO || COMPILE_TEST
+	depends on HAS_IOMEM
+	help
+	  Read the public user words and device ID from the SG2002 eFuse
+	  shadow registers. Other fields are hidden. Fuse programming is
+	  not supported. The module is called sg2002-efuse.
+
 config NVMEM_SUNPLUS_OCOTP
 	tristate "Sunplus SoC OTP support"
 	depends on SOC_SP7021 || COMPILE_TEST
diff --git a/drivers/nvmem/Makefile b/drivers/nvmem/Makefile
index 7252b8e..3a7653f 100644
--- a/drivers/nvmem/Makefile
+++ b/drivers/nvmem/Makefile
@@ -79,6 +79,7 @@ nvmem_sprd_efuse-y			:= sprd-efuse.o
 obj-$(CONFIG_NVMEM_STM32_ROMEM)		+= nvmem_stm32_romem.o
 nvmem_stm32_romem-y 			:= stm32-romem.o
 nvmem_stm32_romem-$(CONFIG_NVMEM_STM32_BSEC_OPTEE_TA) += stm32-bsec-optee-ta.o
+obj-$(CONFIG_NVMEM_SG2002_EFUSE)		+= sg2002-efuse.o
 obj-$(CONFIG_NVMEM_SUNPLUS_OCOTP)	+= nvmem_sunplus_ocotp.o
 nvmem_sunplus_ocotp-y			:= sunplus-ocotp.o
 obj-$(CONFIG_NVMEM_SUNXI_SID)		+= nvmem_sunxi_sid.o
diff --git a/drivers/nvmem/sg2002-efuse.c b/drivers/nvmem/sg2002-efuse.c
new file mode 100644
index 0000000..1465430
--- /dev/null
+++ b/drivers/nvmem/sg2002-efuse.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Read-only access to the SG2002's public eFuse shadow words. */
+
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-provider.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define SG2002_EFUSE_SHADOW 0x100
+#define SG2002_EFUSE_SIZE 0x100
+
+struct sg2002_efuse {
+	void __iomem *base;
+	struct clk_bulk_data clocks[2];
+	struct mutex lock;
+};
+
+/*
+ * Only the ten user words and the eight-byte device ID are public here.
+ * Keep the physical shadow offsets: user words have four-byte gaps.
+ * NVMEM fills all other ranges with zero without reading the hardware.
+ * In particular, this excludes the loader and device encryption keys.
+ */
+static const struct nvmem_keepout sg2002_efuse_keepout[] = {
+	{ .start = 0x00, .end = 0x40 },
+	{ .start = 0x44, .end = 0x48 },
+	{ .start = 0x4c, .end = 0x50 },
+	{ .start = 0x54, .end = 0x58 },
+	{ .start = 0x5c, .end = 0x60 },
+	{ .start = 0x64, .end = 0x68 },
+	{ .start = 0x6c, .end = 0x70 },
+	{ .start = 0x74, .end = 0x78 },
+	{ .start = 0x7c, .end = 0x80 },
+	{ .start = 0x84, .end = 0x88 },
+	{ .start = 0x94, .end = SG2002_EFUSE_SIZE },
+};
+
+static int sg2002_efuse_read(void *context, unsigned int offset,
+			   void *val, size_t bytes)
+{
+	struct sg2002_efuse *efuse = context;
+	u8 *buf = val;
+	int ret;
+
+	mutex_lock(&efuse->lock);
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(efuse->clocks), efuse->clocks);
+	if (ret)
+		goto unlock;
+
+	/* The shadow aperture supports word reads, including for byte cells. */
+	while (bytes) {
+		unsigned int skip = offset % sizeof(u32);
+		size_t count = min_t(size_t, bytes, sizeof(u32) - skip);
+		__le32 word;
+
+		word = cpu_to_le32(readl(efuse->base + SG2002_EFUSE_SHADOW +
+					(offset & ~3U)));
+		memcpy(buf, (u8 *)&word + skip, count);
+		buf += count;
+		offset += count;
+		bytes -= count;
+	}
+
+	clk_bulk_disable_unprepare(ARRAY_SIZE(efuse->clocks), efuse->clocks);
+unlock:
+	mutex_unlock(&efuse->lock);
+	return ret;
+}
+
+static int sg2002_efuse_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct nvmem_config config = {
+		.dev = dev,
+		.name = "sg2002-efuse",
+		.id = NVMEM_DEVID_AUTO,
+		.type = NVMEM_TYPE_OTP,
+		.owner = THIS_MODULE,
+		.size = SG2002_EFUSE_SIZE,
+		.word_size = 1,
+		.stride = 1,
+		.read_only = true,
+		.root_only = true,
+		.reg_read = sg2002_efuse_read,
+		.keepout = sg2002_efuse_keepout,
+		.nkeepout = ARRAY_SIZE(sg2002_efuse_keepout),
+	};
+	struct sg2002_efuse *efuse;
+	int ret;
+
+	efuse = devm_kzalloc(dev, sizeof(*efuse), GFP_KERNEL);
+	if (!efuse)
+		return -ENOMEM;
+
+	efuse->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(efuse->base))
+		return PTR_ERR(efuse->base);
+
+	efuse->clocks[0].id = "efuse";
+	efuse->clocks[1].id = "apb";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(efuse->clocks), efuse->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	ret = devm_mutex_init(dev, &efuse->lock);
+	if (ret)
+		return ret;
+
+	config.priv = efuse;
+	return PTR_ERR_OR_ZERO(devm_nvmem_register(dev, &config));
+}
+
+static const struct of_device_id sg2002_efuse_match[] = {
+	{ .compatible = "sophgo,sg2002-efuse" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sg2002_efuse_match);
+
+static struct platform_driver sg2002_efuse_driver = {
+	.probe = sg2002_efuse_probe,
+	.driver = {
+		.name = "sg2002-efuse",
+		.of_match_table = sg2002_efuse_match,
+	},
+};
+module_platform_driver(sg2002_efuse_driver);
+
+MODULE_DESCRIPTION("Sophgo SG2002 public eFuse shadow reader");
+MODULE_AUTHOR("George Whewell <georgerw@gmail.com>");
+MODULE_LICENSE("GPL");
