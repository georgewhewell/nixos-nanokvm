From: bloqaudio <qoshea@gmail.com>
Subject: [PATCH] dmaengine: dw-axi-dmac: queue the whole scatterlist entry

dw_axi_dma_chan_prep_slave_sg() splits each scatterlist entry into
segments of equal, rounded-up length and loops while a full segment
remains. When the length is not a multiple of that segment length, the
tail is never queued: a 4095-byte entry with a 1024-byte block limit
becomes three 1024-byte segments, and the fourth descriptor, counted by
sg_nents_for_dma(), is left uninitialised. set_desc_last() then writes
through its NULL lli pointer.

The even split can also start a segment off a word boundary. A 4092-byte
receive becomes four 1023-byte segments; the second fails the alignment
check in dw_axi_dma_set_hw_desc().

Queue whole blocks followed by the remainder. That matches the count
sg_nents_for_dma() allocates, and every segment but the last starts on a
block boundary.
---
 drivers/dma/dw-axi-dmac/dw-axi-dmac-platform.c | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

--- a/drivers/dma/dw-axi-dmac/dw-axi-dmac-platform.c
+++ b/drivers/dma/dw-axi-dmac/dw-axi-dmac-platform.c
@@ -849,11 +849,11 @@
 	struct axi_dma_chan *chan = dchan_to_axi_dma_chan(dchan);
 	struct axi_dma_hw_desc *hw_desc = NULL;
 	struct axi_dma_desc *desc = NULL;
-	u32 num_segments, segment_len;
 	unsigned int loop = 0;
 	struct scatterlist *sg;
 	size_t axi_block_len;
 	u32 len, num_sgs;
+	u32 segment_len;
 	unsigned int i;
 	dma_addr_t mem;
 	int status;
@@ -882,10 +882,14 @@
 	for_each_sg(sgl, sg, sg_len, i) {
 		mem = sg_dma_address(sg);
 		len = sg_dma_len(sg);
-		num_segments = DIV_ROUND_UP(sg_dma_len(sg), axi_block_len);
-		segment_len = DIV_ROUND_UP(sg_dma_len(sg), num_segments);
 
+		/*
+		 * Whole blocks, then the remainder. An even split rounds the
+		 * segment length up, which leaves a tail shorter than a
+		 * segment unqueued and can start a segment off a word boundary.
+		 */
 		do {
+			segment_len = min_t(u32, len, axi_block_len);
 			hw_desc = &desc->hw_desc[loop++];
 			status = dw_axi_dma_set_hw_desc(chan, hw_desc, mem, segment_len);
 			if (status < 0)
@@ -894,7 +898,7 @@
 			desc->length += hw_desc->len;
 			len -= segment_len;
 			mem += segment_len;
-		} while (len >= segment_len);
+		} while (len);
 	}
 
 	/* Set end-of-link to the last link descriptor of list */
