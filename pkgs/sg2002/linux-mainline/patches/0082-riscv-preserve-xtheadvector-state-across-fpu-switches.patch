From: NanoKVM contributors
Subject: [PATCH] riscv: preserve XTheadVector state across FPU switches

SG2002's C906 aliases VXRM and VXSAT into FCSR[10:8]. Restoring the
incoming task's FCSR before saving the outgoing vector CSRs corrupts
its vector rounding and saturation state. Save vector state first.

Writes to those vector CSRs dirty FS without necessarily dirtying VS.
Refresh only those two controls when the register file is clean (the
register save itself changes VL/VTYPE), and account for
FS dirtiness when tracking preemptible kernel vector state. Do not
snapshot INITIAL state: a deferred restore may still be pending.

Also use the T-Head VS bits in riscv_v_is_on(), so preemptible kernel
vector context handling recognizes an active XTheadVector context.
Trap entry must clear those bits too: clearing standard VS and SPELP
leaves T-Head VS half-enabled, confusing IRQ preemption with a direct
schedule from a vector region. Expose the vendor keys to assembly for
the trap-entry alternative.

diff --git a/arch/riscv/include/asm/switch_to.h b/arch/riscv/include/asm/switch_to.h
--- a/arch/riscv/include/asm/switch_to.h
+++ b/arch/riscv/include/asm/switch_to.h
@@ -115,10 +115,11 @@
 	struct task_struct *__prev = (prev);		\
 	struct task_struct *__next = (next);		\
 	__set_prev_cpu(__prev->thread);			\
+	/* Save vector CSRs before restoring an aliased FCSR. */ \
+	if (has_vector() || has_xtheadvector())		\
+		__switch_to_vector(__prev, __next);	\
 	if (has_fpu())					\
 		__switch_to_fpu(__prev, __next);	\
-	if (has_vector() || has_xtheadvector())		\
-		__switch_to_vector(__prev, __next);	\
 	if (switch_to_should_flush_icache(__next))	\
 		local_flush_icache_all();		\
 	__switch_to_envcfg(__next);			\
diff --git a/arch/riscv/include/asm/vector.h b/arch/riscv/include/asm/vector.h
--- a/arch/riscv/include/asm/vector.h
+++ b/arch/riscv/include/asm/vector.h
@@ -123,7 +123,20 @@
 
 static __always_inline bool riscv_v_is_on(void)
 {
-	return !!(csr_read(CSR_SSTATUS) & SR_VS);
+	return !!(csr_read(CSR_SSTATUS) & (has_xtheadvector() ? SR_VS_THEAD : SR_VS));
+}
+
+/* VXRM/VXSAT need FS enabled and may also alias FCSR on T-Head cores. */
+static __always_inline unsigned long __thead_vcsr_read(void)
+{
+	unsigned long status, vcsr;
+
+	status = csr_read_set(CSR_STATUS, SR_FS_DIRTY);
+	vcsr = csr_read(CSR_VXSAT) | csr_read(CSR_VXRM) << CSR_VXRM_SHIFT;
+	if ((status & SR_FS) != SR_FS_DIRTY)
+		csr_write(CSR_STATUS, status);
+
+	return vcsr;
 }
 
 static __always_inline void __vstate_csr_save(struct __riscv_v_ext_state *dest)
@@ -136,28 +149,9 @@
 		"=r" (dest->vcsr) : :);
 
 	if (has_xtheadvector()) {
-		unsigned long status;
-
-		/*
-		 * CSR_VCSR is defined as
-		 * [2:1] - vxrm[1:0]
-		 * [0] - vxsat
-		 * The earlier vector spec implemented by T-Head uses separate
-		 * registers for the same bit-elements, so just combine those
-		 * into the existing output field.
-		 *
-		 * Additionally T-Head cores need FS to be enabled when accessing
-		 * the VXRM and VXSAT CSRs, otherwise ending in illegal instructions.
-		 * Though the cores do not implement the VXRM and VXSAT fields in the
-		 * FCSR CSR that vector-0.7.1 specifies.
-		 */
-		status = csr_read_set(CSR_STATUS, SR_FS_DIRTY);
-		dest->vcsr = csr_read(CSR_VXSAT) | csr_read(CSR_VXRM) << CSR_VXRM_SHIFT;
-
+		/* Pack the separate CSRs into the standard VCSR layout. */
+		dest->vcsr = __thead_vcsr_read();
 		dest->vlenb = riscv_v_vsize / 32;
-
-		if ((status & SR_FS) != SR_FS_DIRTY)
-			csr_write(CSR_STATUS, status);
 	} else {
 		dest->vcsr = csr_read(CSR_VCSR);
 		dest->vlenb = csr_read(CSR_VLENB);
@@ -309,6 +303,12 @@
 	if (__riscv_v_vstate_check(regs->status, DIRTY)) {
 		__riscv_v_vstate_save(vstate, vstate->datap);
 		__riscv_v_vstate_clean(regs);
+	} else if (has_xtheadvector() && __riscv_v_vstate_check(regs->status, CLEAN)) {
+		/* C906 writes to VXRM/VXSAT dirty FS, but can leave VS clean. */
+		riscv_v_enable();
+		/* A prior save may have changed VL/VTYPE; refresh only the aliases. */
+		vstate->vcsr = __thead_vcsr_read();
+		riscv_v_disable();
 	}
 }
 
diff --git a/arch/riscv/include/asm/vendor_extensions/thead.h b/arch/riscv/include/asm/vendor_extensions/thead.h
--- a/arch/riscv/include/asm/vendor_extensions/thead.h
+++ b/arch/riscv/include/asm/vendor_extensions/thead.h
@@ -4,12 +4,13 @@
 
 #include <asm/vendor_extensions.h>
 
-#include <linux/types.h>
-
 /*
  * Extension keys must be strictly less than RISCV_ISA_VENDOR_EXT_MAX.
  */
 #define RISCV_ISA_VENDOR_EXT_XTHEADVECTOR		0
+
+#ifndef __ASSEMBLER__
+#include <linux/types.h>
 
 extern struct riscv_isa_vendor_ext_data_list riscv_isa_vendor_ext_list_thead;
 
@@ -18,6 +19,8 @@
 #else
 static inline void disable_xtheadvector(void) { }
 #endif
+
+#endif /* !__ASSEMBLER__ */
 
 /* Extension specific helpers */
 
diff --git a/arch/riscv/include/asm/vendor_extensions.h b/arch/riscv/include/asm/vendor_extensions.h
--- a/arch/riscv/include/asm/vendor_extensions.h
+++ b/arch/riscv/include/asm/vendor_extensions.h
@@ -6,15 +6,23 @@
 #ifndef _ASM_VENDOR_EXTENSIONS_H
 #define _ASM_VENDOR_EXTENSIONS_H
 
+/*
+ * The extension keys of each vendor must be strictly less than this value.
+ */
+#define RISCV_ISA_VENDOR_EXT_MAX 32
+
+/*
+ * The alternatives need some way of distinguishing between vendor extensions
+ * and errata. Incrementing all of the vendor extension keys so they are at
+ * least 0x8000 accomplishes that.
+ */
+#define RISCV_VENDOR_EXT_ALTERNATIVES_BASE	0x8000
+
+#ifndef __ASSEMBLER__
 #include <asm/cpufeature.h>
 
 #include <linux/array_size.h>
 #include <linux/types.h>
-
-/*
- * The extension keys of each vendor must be strictly less than this value.
- */
-#define RISCV_ISA_VENDOR_EXT_MAX 32
 
 struct riscv_isavendorinfo {
 	DECLARE_BITMAP(isa, RISCV_ISA_VENDOR_EXT_MAX);
@@ -31,13 +39,6 @@
 extern struct riscv_isa_vendor_ext_data_list *riscv_isa_vendor_ext_list[];
 
 extern const size_t riscv_isa_vendor_ext_list_size;
-
-/*
- * The alternatives need some way of distinguishing between vendor extensions
- * and errata. Incrementing all of the vendor extension keys so they are at
- * least 0x8000 accomplishes that.
- */
-#define RISCV_VENDOR_EXT_ALTERNATIVES_BASE	0x8000
 
 #define VENDOR_EXT_ALL_CPUS			-1
 
@@ -101,4 +102,6 @@
 	return __riscv_isa_vendor_extension_available(cpu, vendor, ext);
 }
 
+#endif /* !__ASSEMBLER__ */
+
 #endif /* _ASM_VENDOR_EXTENSIONS_H */
diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -16,6 +16,8 @@
 #include <asm/thread_info.h>
 #include <asm/asm-offsets.h>
 #include <asm/errata_list.h>
+#include <asm/vendorid_list.h>
+#include <asm/vendor_extensions/thead.h>
 #include <linux/sizes.h>
 
 	.section .irqentry.text, "ax"
@@ -178,7 +180,12 @@
 	 * Disable the FPU/Vector to detect illegal usage of floating point
 	 * or vector in kernel space.
 	 */
-	li t0, SR_SUM | SR_FS_VS
+	/* T-Head VS lives outside the standard SR_VS field. */
+	ALTERNATIVE(__stringify(li t0, SR_SUM | SR_FS_VS), \
+		    __stringify(li t0, SR_SUM | SR_FS_VS | SR_VS_THEAD), \
+		    THEAD_VENDOR_ID, \
+		    RISCV_VENDOR_EXT_ALTERNATIVES_BASE + RISCV_ISA_VENDOR_EXT_XTHEADVECTOR, \
+		    CONFIG_RISCV_ISA_XTHEADVECTOR)
 #ifdef CONFIG_64BIT
 	li t1, SR_ELP
 	or t0, t0, t1
diff --git a/arch/riscv/kernel/kernel_mode_vector.c b/arch/riscv/kernel/kernel_mode_vector.c
--- a/arch/riscv/kernel/kernel_mode_vector.c
+++ b/arch/riscv/kernel/kernel_mode_vector.c
@@ -123,7 +123,7 @@
 
 static int riscv_v_start_kernel_context(bool *is_nested)
 {
-	struct __riscv_v_ext_state *kvstate, *uvstate;
+	struct __riscv_v_ext_state *kvstate;
 
 	kvstate = &current->thread.kernel_vstate;
 	if (!kvstate->datap)
@@ -143,10 +143,7 @@
 
 	/* Transfer the ownership of V from user to kernel, then save */
 	riscv_v_start(RISCV_PREEMPT_V | RISCV_PREEMPT_V_DIRTY);
-	if (__riscv_v_vstate_check(task_pt_regs(current)->status, DIRTY)) {
-		uvstate = &current->thread.vstate;
-		__riscv_v_vstate_save(uvstate, uvstate->datap);
-	}
+	riscv_v_vstate_save(&current->thread.vstate, task_pt_regs(current));
 	riscv_preempt_v_clear_dirty(current);
 	return 0;
 }
@@ -160,7 +157,8 @@
 		return;
 
 	depth = riscv_v_ctx_get_depth();
-	if (depth == 0 && __riscv_v_vstate_check(regs->status, DIRTY))
+	if (depth == 0 && (__riscv_v_vstate_check(regs->status, DIRTY) ||
+			   (has_xtheadvector() && (regs->status & SR_FS) == SR_FS_DIRTY)))
 		riscv_preempt_v_set_dirty();
 
 	riscv_v_ctx_depth_inc();
