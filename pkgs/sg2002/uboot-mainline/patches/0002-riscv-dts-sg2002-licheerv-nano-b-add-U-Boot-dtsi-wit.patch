From 857c47e98e106b0aa5dae646c7ec623ec94e3aa0 Mon Sep 17 00:00:00 2001
From: George Watson <george@hellas.ai>
Date: Fri, 24 Apr 2026 12:48:59 +0200
Subject: [PATCH 2/4] riscv: dts: sg2002-licheerv-nano-b: add U-Boot dtsi with
 dwc2 gadget
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add an -u-boot.dtsi overlay for the LicheeRV Nano B board that declares a
DesignWare HS-OTG controller node at 0x04340000 in peripheral mode. This
gives U-Boot's dwc2_udc_otg driver (compatible "snps,dwc2") a device to
bind against so the fastboot USB gadget enumerates when distro_bootcmd
falls through to "fastboot usb 0".

The kernel uses compatible "sophgo,cv1800b-usb", but U-Boot has no
matching driver; "snps,dwc2" is the generic match U-Boot knows. Clock,
reset and phy phandles are intentionally omitted — U-Boot has no cv1800
clock/reset/phy drivers, and the FSBL has already initialised the USB
block (the ROM USB download path uses the same IP).

Signed-off-by: George Watson <george@hellas.ai>
---
 .../dts/sg2002-licheerv-nano-b-u-boot.dtsi      | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)
 create mode 100644 arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi

diff --git a/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi b/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi
new file mode 100644
index 00000000..6995d46c
--- /dev/null
+++ b/arch/riscv/dts/sg2002-licheerv-nano-b-u-boot.dtsi
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0+
+// U-Boot overlay: add dwc2 USB node for fastboot gadget.
+// snps,dwc2 compatible matches U-Boot's dwc2_udc_otg driver.
+// FSBL already initialized USB clock/phy, so we skip those refs.
+
+/ {
+	soc {
+		usb@4340000 {
+			compatible = "snps,dwc2";
+			reg = <0x04340000 0x10000>;
+			dr_mode = "peripheral";
+			g-rx-fifo-size = <1536>;
+			g-np-tx-fifo-size = <32>;
+			g-tx-fifo-size = <128 128 64 64 64 64 32 32>;
+		};
+	};
+};
