From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NixOS NanoKVM <nanokvm@localhost>
Date: Fri, 4 Sep 2026 12:00:00 +0200
Subject: [PATCH] lmb: respect SYS_MEM_TOP_HIDE for allocations

SYS_MEM_TOP_HIDE promises that the excluded top-of-RAM area will not be
touched by U-Boot.  U-Boot's relocation and malloc placement honor the
reduced gd->ram_top, but the LMB map normally continues to expose the full
DRAM bank.  EFI page allocation can consequently place data in the hidden
area.

LMB_LIMIT_DMA_BELOW_RAM_TOP already makes lmb_add_memory() reserve the part
of a DRAM bank above gd->ram_top.  Enable it by default whenever
SYS_MEM_TOP_HIDE is non-zero, so LMB clients observe the same boundary as
the rest of U-Boot.

Signed-off-by: NixOS NanoKVM <nanokvm@localhost>
---
 lib/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/Kconfig b/lib/Kconfig
index 2e85c1d25a..2ba025e6bd 100644
--- a/lib/Kconfig
+++ b/lib/Kconfig
@@ -1314,7 +1314,7 @@ config LMB_ARCH_MEM_MAP
 config LMB_LIMIT_DMA_BELOW_RAM_TOP
 	bool
 	depends on LMB
-	default y if ARCH_BCM283X || ARCH_ROCKCHIP || STARFIVE_JH7110
+	default y if ARCH_BCM283X || ARCH_ROCKCHIP || STARFIVE_JH7110 || SYS_MEM_TOP_HIDE != 0x0
 	help
 	  Some architectures can not DMA above ram_top boundary,
 	  which is after 4 GiB or 32-bit boundary too. Limit the
